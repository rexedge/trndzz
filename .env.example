# Database (Neon / PostgreSQL)
DATABASE_URL="postgresql://user:password@host/trndzz?sslmode=require"
DIRECT_URL="postgresql://user:password@host/trndzz?sslmode=require"

# Multi-Tenant & Domain Routing
# Pre-Launch Local Dev: keep http://localhost:3000 (verticals resolve at http://aluminium.localhost:3000, etc.)
# Pre-DNS Staging (e.g. Vercel preview): set https://your-preview.vercel.app (verticals auto-fallback to /vertical/[slug])
# Live Wildcard Production: set https://trndzz.com + wildcard DNS *.trndzz.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ROOT_DOMAIN="trndzz.com"

# Better Auth (Cross-Subdomain Authentication)
BETTER_AUTH_SECRET="generate-a-32-char-random-secret-here"
BETTER_AUTH_URL="http://localhost:3000"

# Transactional Trade & Claim-Conversion Alerts (Optional in Local Dev — falls back to DRY_RUN_LOGGED in /admin/notifications)
RESEND_API_KEY=""
EMAIL_FROM="Trndzz Trade Desk <alerts@trndzz.com>"
WHATSAPP_ALERT_WEBHOOK_URL=""

# OpenAI (Semantic Search & Spec Normalization Only — deterministic keyword fallback if unset)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# S3 / Object Storage (Logos, Datasheets, CAC Verification Docs)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_BUCKET_NAME="isce-image-uploader"

# Analytics (PostHog — cross-subdomain funnel telemetry; no-ops safely if key is empty)
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
NEXT_PUBLIC_POSTHOG_DEBUG="false"
